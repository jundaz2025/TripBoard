# Public browser configuration only; VITE_ values are embedded in the client bundle at build time.
# Optional browser key, restricted to your website URLs and Maps JavaScript API.
# Never put your OpenAI key in a VITE_ variable.
VITE_GOOGLE_MAPS_API_KEY=
# Optional cloud map ID; DEMO_MAP_ID is used for local testing if omitted.
VITE_GOOGLE_MAPS_MAP_ID=
