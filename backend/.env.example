# Local development template. Copy to .env and keep real credentials out of version control.
DATABASE_URL=postgresql+psycopg://tripboard:tripboard_local_dev@127.0.0.1:5432/tripboard
REDIS_URL=redis://127.0.0.1:6379/0
APP_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
COOKIE_SECURE=false
# Optional. Keep API keys on the backend only; never use a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Public OSRM demo for low-volume local use; use your own provider for production.
# Set to empty to disable road routing. Estimated walking stays available.
OSRM_URL=https://router.project-osrm.org
# Geocoding provider; requests are cached and rate-limited across the app.
NOMINATIM_URL=https://nominatim.openstreetmap.org
